APP_URL=http://localhost:3000

# PostgreSQL / Drizzle
DATABASE_URL=postgres://postgres:postgres@localhost:5432/intellia

# LLM providers
OPENAI_API_KEY=
# Best quality: gpt-5.6-sol. Balanced: gpt-5.6-terra. Lower-cost: gpt-5.6-luna.
OPENAI_MODEL=gpt-5.6-sol
OPENAI_FALLBACK_MODEL=gpt-5.6-terra
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Public collection
FIRECRAWL_API_KEY=
YOUCOM_API_KEY=
# Candidate pool size searched before the requested top competitors are researched.
COMPETITOR_DISCOVERY_POOL_SIZE=20
# Safe default for a 14-request/minute Firecrawl plan. The collector also honors provider retry delays.
FIRECRAWL_MIN_INTERVAL_MS=5500
# Independent competitors can overlap safely because Firecrawl calls remain globally paced.
LIVE_RESEARCH_COMPETITOR_CONCURRENCY=5
# The interactive endpoint returns 202; Railway completes and persists the run in the background.

# Optional OpenAI web-grounded deep research. Keep the small per-run budget while public runs are enabled.
DEEP_RESEARCH_ENABLED=false
DEEP_RESEARCH_PROVIDER=openai
OPENAI_DEEP_RESEARCH_MODEL=o4-mini-deep-research
DEEP_RESEARCH_POLICY=auto
DEEP_RESEARCH_MAX_COMPETITORS_PER_RUN=2
DEEP_RESEARCH_TIMEOUT_MS=240000
DEEP_RESEARCH_MAX_OUTPUT_TOKENS=6000

# Required in production. Used to hash public rate-limit keys; use a long, unique random value.
INTELLIA_AUTH_SECRET=replace-with-a-long-random-session-signing-secret
INTELLIA_REFRESH_SECRET=replace-with-a-long-random-refresh-secret

# Seller-facing external intelligence scope
SELLER_COMPANY_NAME=Your Company
SELLER_COMPANY_WEBSITE=https://company.example
SELLER_COMPETITOR_COUNT=5

# Live collection is disabled until all required providers and Postgres are configured.
LIVE_RESEARCH_ENABLED=false
# Public prototype safety limit. Set higher temporarily only while supervised.
PUBLIC_RESEARCH_RUNS_PER_HOUR=2
# Hide a persisted run once it is older than this threshold; a new verified run is required.
EXTERNAL_INTELLIGENCE_MAX_AGE_HOURS=36
